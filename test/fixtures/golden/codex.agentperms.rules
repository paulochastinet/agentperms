# Managed by agentperms (https://github.com/paulochastinet/agentperms).
# Do not edit: this file is regenerated by `agentperms apply`. Edit agentperms.yaml instead.
# Codex applies the most restrictive matching rule: forbidden > prompt > allow.

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "agentperms: shell.deny \"rm -rf *\"",
)

prefix_rule(
    pattern = ["curl"],
    decision = "forbidden",
    justification = "agentperms: shell.deny \"curl *\"",
)

prefix_rule(
    pattern = ["sh"],
    decision = "forbidden",
    justification = "agentperms: shell.deny \"sh\"",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "agentperms: shell.ask \"git push *\"",
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "agentperms: shell.allow \"git diff *\"",
)

prefix_rule(
    pattern = ["npm", "run", "test"],
    decision = "allow",
    justification = "agentperms: shell.allow \"npm run test *\"",
)

prefix_rule(
    pattern = ["ls"],
    decision = "allow",
    justification = "agentperms: shell.allow \"ls *\"",
)
